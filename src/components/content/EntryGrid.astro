---
import EntryCard from "./EntryCard.astro";
import type { Entry, EntryCollection } from "@/lib/content";

interface Props {
  entries: Entry[];
  collection: EntryCollection;
  columns?: 2 | 3;
}
const { entries, collection, columns = 2 } = Astro.props;
---

<div
  data-reveal-stagger
  class:list={["grid gap-6", columns === 3 ? "sm:grid-cols-2 lg:grid-cols-3" : "sm:grid-cols-2"]}
>
  {entries.map((entry, i) => <EntryCard entry={entry} collection={collection} eager={i < 2} />)}
</div>

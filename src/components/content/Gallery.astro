---
/**
 * Responsive masonry gallery with an accessible lightbox (native <dialog>).
 * Works for frontmatter galleries and can be used directly inside MDX:
 *   <Gallery images={[{ src: img, alt: "…", caption: "…" }]} />
 */
import type { ImageMetadata } from "astro";
import { Image, getImage } from "astro:assets";

export interface GalleryItem {
  src: ImageMetadata;
  alt: string;
  caption?: string;
}
interface Props {
  images: GalleryItem[];
  title?: string;
}
const { images, title } = Astro.props;

const items = await Promise.all(
  images.map(async (img) => ({
    ...img,
    full: (await getImage({ src: img.src, width: Math.min(img.src.width, 1920), format: "webp" })).src,
  })),
);
---

{
  items.length > 0 && (
    <section class="not-prose my-12" data-gallery>
      {title && <h2 class="mb-6 font-heading text-2xl font-semibold tracking-tight">{title}</h2>}
      <div class="columns-1 gap-4 sm:columns-2 lg:columns-3" data-reveal-stagger>
        {items.map((img, i) => (
          <figure class="mb-4 break-inside-avoid">
            <button
              type="button"
              class="group relative block w-full overflow-hidden rounded-xl bg-muted ring-1 ring-foreground/10 focus-visible:ring-2 focus-visible:ring-ring focus-visible:outline-none"
              data-gallery-open={i}
              aria-label={`Open image: ${img.alt}`}
            >
              <Image
                src={img.src}
                alt={img.alt}
                widths={[400, 700]}
                sizes="(min-width: 1024px) 33vw, (min-width: 640px) 50vw, 100vw"
                class="h-auto w-full transition-transform duration-700 group-hover:scale-105"
              />
              <span class="absolute inset-0 bg-linear-to-t from-black/40 to-transparent opacity-0 transition-opacity group-hover:opacity-100" />
            </button>
            {img.caption && <figcaption class="mt-2 text-xs text-muted-foreground">{img.caption}</figcaption>}
          </figure>
        ))}
      </div>

      <dialog
        class="m-auto max-h-none max-w-none bg-transparent p-0 backdrop:bg-black/85 backdrop:backdrop-blur-sm open:flex"
        data-gallery-dialog
        aria-label="Image viewer"
      >
        <div class="relative flex h-dvh w-screen items-center justify-center p-4 md:p-12" data-lightbox-stage>
          <img data-lightbox-img alt="" class="max-h-[80dvh] max-w-full rounded-lg object-contain shadow-2xl" />
          <p data-lightbox-caption class="absolute inset-x-0 bottom-6 px-6 text-center text-sm text-white/85" />
          <p data-lightbox-count class="absolute top-5 left-6 font-mono text-xs text-white/70" />
          <button type="button" data-lightbox-close aria-label="Close" class="absolute top-4 right-4 grid size-10 place-items-center rounded-full bg-white/10 text-white hover:bg-white/20">✕</button>
          <button type="button" data-lightbox-prev aria-label="Previous image" class="absolute left-3 grid size-11 place-items-center rounded-full bg-white/10 text-2xl text-white hover:bg-white/20">‹</button>
          <button type="button" data-lightbox-next aria-label="Next image" class="absolute right-3 grid size-11 place-items-center rounded-full bg-white/10 text-2xl text-white hover:bg-white/20">›</button>
        </div>
        <script type="application/json" data-gallery-data set:html={JSON.stringify(items.map(({ full, alt, caption }) => ({ full, alt, caption })))} />
      </dialog>
    </section>
  )
}

<script>
  type Item = { full: string; alt: string; caption?: string };

  document.querySelectorAll<HTMLElement>("[data-gallery]").forEach((gallery) => {
    const dialog = gallery.querySelector<HTMLDialogElement>("[data-gallery-dialog]")!;
    const items: Item[] = JSON.parse(gallery.querySelector("[data-gallery-data]")!.textContent || "[]");
    const img = dialog.querySelector<HTMLImageElement>("[data-lightbox-img]")!;
    const caption = dialog.querySelector<HTMLElement>("[data-lightbox-caption]")!;
    const count = dialog.querySelector<HTMLElement>("[data-lightbox-count]")!;
    let index = 0;

    const show = (i: number) => {
      index = (i + items.length) % items.length;
      const item = items[index];
      img.src = item.full;
      img.alt = item.alt;
      caption.textContent = item.caption ?? "";
      count.textContent = `${index + 1} / ${items.length}`;
    };

    gallery.querySelectorAll<HTMLElement>("[data-gallery-open]").forEach((btn) =>
      btn.addEventListener("click", () => {
        show(Number(btn.dataset.galleryOpen));
        dialog.showModal();
        window.__lenis?.stop();
      }),
    );
    dialog.addEventListener("close", () => window.__lenis?.start());
    dialog.querySelector("[data-lightbox-close]")!.addEventListener("click", () => dialog.close());
    dialog.querySelector("[data-lightbox-prev]")!.addEventListener("click", () => show(index - 1));
    dialog.querySelector("[data-lightbox-next]")!.addEventListener("click", () => show(index + 1));
    // click on the backdrop area closes
    dialog.addEventListener("click", (e) => {
      if (e.target === dialog || (e.target as HTMLElement).hasAttribute("data-lightbox-stage")) dialog.close();
    });
    dialog.addEventListener("keydown", (e) => {
      if (e.key === "ArrowRight") show(index + 1);
      if (e.key === "ArrowLeft") show(index - 1);
    });
  });
</script>

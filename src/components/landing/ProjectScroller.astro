---
/**
 * Featured projects. Desktop: pinned horizontal scroll (GSAP ScrollTrigger).
 * Mobile / reduced motion: regular vertical stack.
 */
import { Image } from "astro:assets";
import { ArrowUpRightIcon } from "lucide-react";
import { entryHref, type Entry } from "@/lib/content";
import { buttonClass } from "@/lib/variants";

interface Props {
  projects: Entry<"projects">[];
}
const { projects } = Astro.props;
---

<section class="relative overflow-hidden bg-card/40 py-24 lg:h-dvh lg:py-0" data-hscroll>
  <div class="flex h-full flex-col justify-center gap-12 lg:w-max lg:flex-row lg:items-center lg:gap-0 lg:will-change-transform" data-hscroll-inner>
    <div class="container-page shrink-0 lg:w-[34rem] lg:max-w-none lg:pr-12">
      <p class="mb-3 text-xs font-medium tracking-[0.2em] text-primary uppercase" data-reveal="fade">Selected work</p>
      <h2 class="font-display text-4xl leading-tight tracking-tight md:text-6xl" data-reveal>
        Projects rooted in the <em class="text-primary">field</em>.
      </h2>
      <p class="mt-5 max-w-sm text-muted-foreground" data-reveal>
        Research, design and prototypes, from community biogas to sensor-driven irrigation.
      </p>
      <a href="/projects" class={buttonClass({ size: "lg", className: "mt-8 h-11 rounded-full px-6" })} data-reveal>
        All projects <ArrowUpRightIcon data-icon="inline-end" />
      </a>
    </div>

    <ol class="container-page flex flex-col gap-6 lg:w-max lg:max-w-none lg:flex-row lg:gap-8 lg:px-0 lg:pr-[10vw]" data-hscroll-track>
      {
        projects.map((p, i) => (
          <li class="group relative lg:w-[34rem]">
            <a href={entryHref("projects", p.id)} class="block">
              <div class="relative aspect-[4/3] overflow-hidden rounded-3xl bg-muted ring-1 ring-foreground/10">
                {p.data.cover && (
                  <Image
                    src={p.data.cover}
                    alt={p.data.coverAlt || p.data.title}
                    widths={[480, 800, 1100]}
                    sizes="(min-width: 1024px) 34rem, 100vw"
                    class="h-full w-full max-w-none object-cover will-change-transform lg:w-[120%] transition-[scale] duration-700 group-hover:scale-105"
                    data-hscroll-img
                  />
                )}
                <span class="absolute top-4 left-4 rounded-full bg-background/85 px-3 py-1 font-mono text-xs backdrop-blur">
                  {String(i + 1).padStart(2, "0")}
                </span>
              </div>
              <div class="mt-5 flex items-start justify-between gap-4">
                <div>
                  <h3 class="text-xl font-medium tracking-tight md:text-2xl">{p.data.title}</h3>
                  <p class="mt-1 line-clamp-2 text-sm text-muted-foreground">{p.data.description}</p>
                </div>
                <span class="grid size-11 shrink-0 place-items-center rounded-full border transition-all duration-500 group-hover:rotate-45 group-hover:bg-primary group-hover:text-primary-foreground">
                  <ArrowUpRightIcon className="size-5" />
                </span>
              </div>
            </a>
          </li>
        ))
      }
    </ol>
  </div>
</section>

---
/**
 * Procedural topographic contour lines (a nod to hydrology & land survey).
 * Deterministic: same seed → same SVG. Animated by landing.ts (DrawSVG).
 */
interface Props {
  rings?: number;
  seed?: number;
  class?: string;
}
const { rings = 14, seed = 7, class: className } = Astro.props;

// tiny seeded PRNG so the build output is stable
let s = seed;
const rand = () => ((s = (s * 16807) % 2147483647) / 2147483647);

function contour(cx: number, cy: number, r: number, phase: number[], amp: number[]) {
  const steps = 96;
  const pts: [number, number][] = [];
  for (let i = 0; i < steps; i++) {
    const t = (i / steps) * Math.PI * 2;
    const rr = r + amp[0] * Math.sin(2 * t + phase[0]) + amp[1] * Math.sin(3 * t + phase[1]) + amp[2] * Math.sin(5 * t + phase[2]);
    pts.push([cx + rr * Math.cos(t) * 1.35, cy + rr * Math.sin(t)]);
  }
  // Catmull-Rom → cubic Bézier for smooth closed curves
  let d = `M${pts[0][0].toFixed(1)},${pts[0][1].toFixed(1)}`;
  for (let i = 0; i < steps; i++) {
    const p0 = pts[(i - 1 + steps) % steps], p1 = pts[i], p2 = pts[(i + 1) % steps], p3 = pts[(i + 2) % steps];
    const c1 = [p1[0] + (p2[0] - p0[0]) / 6, p1[1] + (p2[1] - p0[1]) / 6];
    const c2 = [p2[0] - (p3[0] - p1[0]) / 6, p2[1] - (p3[1] - p1[1]) / 6];
    d += `C${c1[0].toFixed(1)},${c1[1].toFixed(1)} ${c2[0].toFixed(1)},${c2[1].toFixed(1)} ${p2[0].toFixed(1)},${p2[1].toFixed(1)}`;
  }
  return d + "Z";
}

const hills = [
  { cx: 1080, cy: 260, rings, gap: 34 },
  { cx: 260, cy: 760, rings: Math.round(rings * 0.7), gap: 30 },
];
const paths = hills.flatMap(({ cx, cy, rings: n, gap }) => {
  const phase = [rand() * 6, rand() * 6, rand() * 6];
  return Array.from({ length: n }, (_, i) => {
    const r = 30 + i * gap;
    const amp = [r * 0.1 + rand() * 6, r * 0.06 + rand() * 4, r * 0.03];
    return { d: contour(cx, cy, r, phase.map((p) => p + i * 0.08), amp), major: i % 5 === 0 };
  });
});
---

<svg
  viewBox="0 0 1440 1000"
  preserveAspectRatio="xMidYMid slice"
  fill="none"
  aria-hidden="true"
  class:list={["pointer-events-none", className]}
  data-topography
>
  {
    paths.map((p) => (
      <path d={p.d} stroke="currentColor" stroke-width={p.major ? 1.4 : 0.8} stroke-opacity={p.major ? 0.5 : 0.28} vector-effect="non-scaling-stroke" />
    ))
  }
</svg>

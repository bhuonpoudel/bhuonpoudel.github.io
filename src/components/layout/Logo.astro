---
import { siteConfig } from "@/config/site";
interface Props {
  class?: string;
  /** Show the full name next to the monogram. */
  showName?: boolean;
}
const { class: className, showName = true } = Astro.props;
---

<a href="/" class:list={["group inline-flex items-center gap-2.5 font-medium", className]} aria-label={`${siteConfig.name}, home`}>
  <span
    class="grid size-8 place-items-center rounded-lg bg-primary text-xs font-semibold tracking-tight text-primary-foreground transition-transform duration-300 group-hover:-rotate-6"
  >
    {siteConfig.initials}
  </span>
  {showName && <span class="hidden text-sm sm:inline">{siteConfig.name}</span>}
</a>

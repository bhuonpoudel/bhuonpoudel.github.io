---
/** MDX callout: <Callout type="tip" title="Optional">…</Callout> */
import { InfoIcon, LightbulbIcon, TriangleAlertIcon } from "lucide-react";

interface Props {
  type?: "note" | "tip" | "warning";
  title?: string;
}
const { type = "note", title } = Astro.props;
const Icon = { note: InfoIcon, tip: LightbulbIcon, warning: TriangleAlertIcon }[type];
---

<aside
  class:list={[
    "not-prose my-6 flex gap-3 rounded-xl border p-4 text-sm",
    type === "warning" ? "border-amber-500/30 bg-amber-500/10" : "border-primary/25 bg-primary/5",
  ]}
>
  <Icon className={`mt-0.5 size-4 shrink-0 ${type === "warning" ? "text-amber-600 dark:text-amber-400" : "text-primary"}`} />
  <div class="space-y-1 [&_a]:underline">
    {title && <p class="font-medium">{title}</p>}
    <div class="text-foreground/85"><slot /></div>
  </div>
</aside>

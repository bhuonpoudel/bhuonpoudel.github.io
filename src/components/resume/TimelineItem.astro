---
/**
 * Generic timeline entry used for employment, education, etc.
 * Left column: dates; right: content card. Extra content goes in the default slot.
 */
import type { ImageMetadata } from "astro";
import { Image } from "astro:assets";
import { MapPinIcon, ArrowUpRightIcon } from "lucide-react";
import { Badge } from "@/components/ui/badge";

interface Props {
  title: string;
  subtitle?: string;
  period: string;
  duration?: string;
  location?: string;
  badge?: string;
  current?: boolean;
  summary?: string;
  highlights?: string[];
  tags?: string[];
  logo?: ImageMetadata;
  href?: string;
}

const { title, subtitle, period, duration, location, badge, current, summary, highlights = [], tags = [], logo, href } =
  Astro.props;
---

<li class="relative grid gap-4 pl-8 md:grid-cols-[12rem_1fr] md:gap-10 md:pl-0" data-reveal>
  <span
    class:list={[
      "absolute top-1.5 left-0 size-[15px] rounded-full border-2 border-background ring-1 md:left-48",
      current ? "bg-primary ring-primary/40" : "bg-muted ring-border",
    ]}
    aria-hidden="true"
  >
    {current && <span class="absolute inset-0 animate-ping rounded-full bg-primary/60" />}
  </span>

  <div class="text-sm md:pt-0.5 md:pr-6 md:text-right">
    <p class="font-medium">{period}</p>
    {duration && <p class="text-muted-foreground">{duration}</p>}
  </div>

  <div class="rounded-2xl border bg-card p-6 transition-colors hover:border-primary/30 md:ml-6">
    <div class="flex items-start gap-4">
      {logo && <Image src={logo} alt="" width={48} height={48} class="size-12 shrink-0 rounded-lg object-contain" />}
      <div class="min-w-0 flex-1">
        <div class="flex flex-wrap items-center gap-2">
          <h3 class="font-heading text-lg leading-snug font-semibold">{title}</h3>
          {badge && <Badge variant={current ? "default" : "secondary"}>{badge}</Badge>}
        </div>
        {
          subtitle && (
            <p class="mt-1 text-muted-foreground">
              {href ? (
                <a href={href} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-1 hover:text-primary">
                  {subtitle} <ArrowUpRightIcon className="size-3.5" />
                </a>
              ) : (
                subtitle
              )}
            </p>
          )
        }
        {location && <p class="mt-1 inline-flex items-center gap-1 text-xs text-muted-foreground"><MapPinIcon className="size-3.5" />{location}</p>}
      </div>
    </div>

    {summary && <p class="mt-4 text-sm text-foreground/85">{summary}</p>}

    {
      highlights.length > 0 && (
        <ul class="mt-4 space-y-2 text-sm text-muted-foreground">
          {highlights.map((h) => (
            <li class="relative pl-5 before:absolute before:top-2 before:left-0 before:size-1.5 before:rounded-full before:bg-primary/60">{h}</li>
          ))}
        </ul>
      )
    }

    <slot />

    {tags.length > 0 && <div class="mt-5 flex flex-wrap gap-1.5">{tags.map((t) => <Badge variant="outline">{t}</Badge>)}</div>}
  </div>
</li>

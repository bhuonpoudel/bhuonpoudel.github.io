---
import BaseHead, { type Props as HeadProps } from "@/components/layout/BaseHead.astro";
import Header from "@/components/layout/Header.astro";
import Footer from "@/components/layout/Footer.astro";

export interface Props extends HeadProps {
  /** Extra classes on <main>. */
  class?: string;
}

const { class: className, ...head } = Astro.props;
---

<!doctype html>
<html lang="en" data-palette="forest">
  <head>
    <BaseHead {...head} />
    <slot name="head" />
  </head>
  <body class="flex min-h-dvh flex-col">
    <a
      href="#main"
      class="sr-only z-50 rounded-md bg-primary px-4 py-2 text-primary-foreground focus:not-sr-only focus:fixed focus:top-3 focus:left-3"
      >Skip to content</a
    >
    <Header />
    <main id="main" class:list={["flex-1", className]}>
      <slot />
    </main>
    <Footer />

    <script>
      import { initMotion } from "@/scripts/motion";
      initMotion();
    </script>
  </body>
</html>

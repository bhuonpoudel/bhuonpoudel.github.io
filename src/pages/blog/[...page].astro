---
import type { GetStaticPaths } from "astro";
import CollectionListing from "@/components/content/CollectionListing.astro";
import { listingPaths } from "@/lib/content";

export const getStaticPaths = listingPaths("blog") satisfies GetStaticPaths;

const { page, tags, total } = Astro.props;
---

<CollectionListing collection="blog" page={page} tags={tags} total={total} />
